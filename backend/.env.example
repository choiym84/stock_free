# Local development defaults. Copy this file to .env only when overriding them.
POSTGRES_DB=stock_free
POSTGRES_USER=stock_free
POSTGRES_PASSWORD=stock_free_local
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW=15m
PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL=3
PASSWORD_RESET_MAX_REQUESTS_PER_IP=20
PASSWORD_RESET_REQUEST_WINDOW=15m
ACCOUNT_NOTIFICATION_DELIVERY=console
FRONTEND_BASE_URL=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@stockfree.local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
